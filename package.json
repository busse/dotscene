{
  "name": "dotscene",
  "version": "0.1.0",
  "description": "Constellation-style scene illustrations made of dots and lines",
  "type": "module",
  "license": "MIT",
  "author": "busse <chrisbusse@gmail.com>",
  "exports": {
    ".": "./src/index.ts",
    "./runtime": "./src/runtime/index.ts"
  },
  "bin": {
    "dotscene": "./bin/dotscene.js"
  },
  "files": [
    "src",
    "bin"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "node bin/dotscene.js build",
    "check": "node bin/dotscene.js check"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
